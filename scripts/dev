#!/usr/bin/env bash
# Lance l’app locale : Postgres (Compose) + migrations + API + Vite.
# Usage : ./scripts/dev
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

DEFAULT_URL="postgresql+psycopg://doux:doux@127.0.0.1:5432/doux_planning"
export DATABASE_URL="${DATABASE_URL:-$DEFAULT_URL}"

API_HOST="${API_HOST:-127.0.0.1}"
API_PORT="${API_PORT:-8000}"
WEB_PORT="${WEB_PORT:-5173}"
PID_DIR="${TMPDIR:-/tmp}/doux-planning-dev"
mkdir -p "$PID_DIR"

die() { echo "error: $*" >&2; exit 1; }

have() { command -v "$1" >/dev/null 2>&1; }

run_py() {
  if have uv; then
    uv run "$@"
  else
    "$@"
  fi
}

compose() {
  if docker compose version >/dev/null 2>&1; then
    docker compose "$@"
  elif have docker-compose; then
    docker-compose "$@"
  else
    die "Docker Compose requis (installe Docker Desktop / docker compose)."
  fi
}

postgres_accepts() {
  # Connexion TCP réelle (pg_isready ne suffit pas si le rôle/db manquent).
  if have uv; then
    DATABASE_URL="$DATABASE_URL" uv run python - <<'PY' >/dev/null 2>&1
import os, sys
import psycopg
try:
    with psycopg.connect(os.environ["DATABASE_URL"].replace("postgresql+psycopg://", "postgresql://"), connect_timeout=2) as c:
        c.execute("SELECT 1")
except Exception:
    sys.exit(1)
PY
  else
    PGPASSWORD="${PGPASSWORD:-doux}" psql -h 127.0.0.1 -U doux -d doux_planning -c 'SELECT 1' >/dev/null 2>&1
  fi
}

wait_postgres() {
  echo "→ attente Postgres sur 5432…"
  local i
  for i in $(seq 1 45); do
    if postgres_accepts; then
      echo "→ Postgres prêt"
      return 0
    fi
    sleep 1
  done
  die "Postgres ne répond pas. Vérifie : docker compose logs db"
}

ensure_deps() {
  if [[ ! -d .venv ]] && have uv; then
    echo "→ uv sync"
    uv sync --extra dev
  fi
  if [[ ! -d web/node_modules ]]; then
    echo "→ npm install (web)"
    npm --prefix web install
  fi
}

start_db() {
  if postgres_accepts; then
    echo "→ Postgres déjà joignable ($DATABASE_URL)"
    return 0
  fi
  have docker || die "Postgres injoignable et Docker absent. Installe Docker, ou un Postgres local (user/db doux / doux_planning)."
  echo "→ docker compose up -d db"
  compose up -d db
  wait_postgres
}

migrate() {
  echo "→ alembic upgrade head"
  run_py alembic upgrade head
}

start_api() {
  if [[ -f "$PID_DIR/api.pid" ]] && kill -0 "$(cat "$PID_DIR/api.pid")" 2>/dev/null; then
    echo "→ redémarrage API (pid $(cat "$PID_DIR/api.pid"))"
    kill "$(cat "$PID_DIR/api.pid")" 2>/dev/null || true
    rm -f "$PID_DIR/api.pid"
    sleep 0.5
  fi
  # Libère le port si un ancien uvicorn traîne
  if have lsof; then
    local old
    old="$(lsof -t -iTCP:"$API_PORT" -sTCP:LISTEN 2>/dev/null || true)"
    if [[ -n "${old:-}" ]]; then
      echo "→ libère le port $API_PORT (pids $old)"
      # shellcheck disable=SC2086
      kill $old 2>/dev/null || true
      sleep 0.5
    fi
  fi
  echo "→ API http://${API_HOST}:${API_PORT}  (DATABASE_URL défini)"
  if have uv; then
    nohup uv run uvicorn doux_planning.api.app:app --reload --host "$API_HOST" --port "$API_PORT" \
      >"$PID_DIR/api.log" 2>&1 &
  else
    nohup uvicorn doux_planning.api.app:app --reload --host "$API_HOST" --port "$API_PORT" \
      >"$PID_DIR/api.log" 2>&1 &
  fi
  echo $! >"$PID_DIR/api.pid"
}

start_web() {
  if [[ -f "$PID_DIR/web.pid" ]] && kill -0 "$(cat "$PID_DIR/web.pid")" 2>/dev/null; then
    echo "→ Vite déjà lancé (pid $(cat "$PID_DIR/web.pid"))"
    return 0
  fi
  if have lsof; then
    local old
    old="$(lsof -t -iTCP:"$WEB_PORT" -sTCP:LISTEN 2>/dev/null || true)"
    if [[ -n "${old:-}" ]]; then
      echo "→ Vite déjà sur le port $WEB_PORT (pids $old) — on réutilise"
      return 0
    fi
  fi
  echo "→ Vite http://127.0.0.1:${WEB_PORT}"
  nohup npm --prefix web run dev -- --host --port "$WEB_PORT" >"$PID_DIR/web.log" 2>&1 &
  echo $! >"$PID_DIR/web.pid"
}

wait_http() {
  local url="$1" label="$2" i
  for i in $(seq 1 40); do
    if curl -sf "$url" >/dev/null 2>&1; then
      echo "→ $label OK"
      return 0
    fi
    sleep 0.5
  done
  echo "warn: $label ne répond pas encore — logs : $PID_DIR/*.log" >&2
}

stop_all() {
  for name in api web; do
    if [[ -f "$PID_DIR/$name.pid" ]]; then
      local pid
      pid="$(cat "$PID_DIR/$name.pid")"
      if kill -0 "$pid" 2>/dev/null; then
        echo "→ stop $name ($pid)"
        kill "$pid" 2>/dev/null || true
      fi
      rm -f "$PID_DIR/$name.pid"
    fi
  done
}

usage() {
  cat <<EOF
Usage: ./scripts/dev [up|stop|status|db|migrate]

  up (défaut)  Postgres + migrations + API + Vite
  stop         Arrête API et Vite (laisse Postgres Compose)
  status       Affiche pids / ports
  db           Uniquement Postgres Compose
  migrate      Uniquement alembic upgrade head

Variables :
  DATABASE_URL  (défaut $DEFAULT_URL)
  API_PORT      (défaut 8000)
  WEB_PORT      (défaut 5173)

Logs : $PID_DIR/api.log  $PID_DIR/web.log
EOF
}

cmd="${1:-up}"
case "$cmd" in
  -h|--help|help) usage; exit 0 ;;
  stop) stop_all; exit 0 ;;
  status)
    echo "DATABASE_URL=$DATABASE_URL"
    echo "pids dir: $PID_DIR"
    for name in api web; do
      if [[ -f "$PID_DIR/$name.pid" ]] && kill -0 "$(cat "$PID_DIR/$name.pid")" 2>/dev/null; then
        echo "$name: running pid=$(cat "$PID_DIR/$name.pid")"
      else
        echo "$name: stopped"
      fi
    done
    compose ps 2>/dev/null || true
    exit 0
    ;;
  db) start_db; exit 0 ;;
  migrate) migrate; exit 0 ;;
  up) ;;
  *) usage; die "commande inconnue: $cmd" ;;
esac

ensure_deps
start_db
migrate
start_api
start_web
wait_http "http://${API_HOST}:${API_PORT}/v1/examples/saint-cloud" "API"
wait_http "http://127.0.0.1:${WEB_PORT}/" "Vite"

cat <<EOF

Prêt.
  UI     → http://127.0.0.1:${WEB_PORT}/
  API    → http://${API_HOST}:${API_PORT}/docs
  Exemple (sans auth) → http://127.0.0.1:${WEB_PORT}/exemple

Inscription / planning live nécessitent cette stack (Postgres + DATABASE_URL).
Sans Postgres, login renvoie 503 « Base indisponible. »

Stop API+Vite : ./scripts/dev stop
Logs          : $PID_DIR/api.log  $PID_DIR/web.log
EOF
